        <!-- Mengirim Notifikasi WA <<extend>> Memperbarui Status Pesanan -->
        <mxCell id="rel_ext_wa" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#000000;" edge="1" parent="1" source="uc_kirim_wa" target="uc_update_status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Mencetak Ulang Nota <<extend>> Melihat Riwayat Transaksi -->
        <mxCell id="rel_ext_cetak_ulang" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#000000;" edge="1" parent="1" source="uc_cetak_ulang" target="uc_riwayat_kasir">
