          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Buat Lembar Data -> Cetak Dokumen -->
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="node_buat_lembar" target="node_cetak_dok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cetak Dokumen -> Dapatkan Persetujuan -->
        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="node_cetak_dok" target="node_dapat_acc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dapatkan Persetujuan -> Pindai & Minta TI -->
        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="node_dapat_acc" target="node_pindai_ti">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pindai & Minta TI -> TI Buat Profil -->
        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="node_pindai_ti" target="node_ti_buat_profil">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TI Buat Profil -> Vendor Berhasil Dibuat -->
        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="node_ti_buat_profil" target="node_vendor_selesai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vendor Berhasil Dibuat -> Selesai -->
        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="node_vendor_selesai" target="node_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
