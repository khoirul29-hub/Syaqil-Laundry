        <mxCell id="e_nota_to_kasir" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;" edge="1" parent="1" source="act_terbit_nota" target="act_terima_nota">
