        <!-- Gabung Tunai & Non-Tunai -> Simpan Lunas -->
        <mxCell id="e_tunai_to_lunas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;" edge="1" parent="1" source="act_hitung_kembalian" target="act_simpan_lunas">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="1310" />
              <mxPoint x="650" y="1310" />
