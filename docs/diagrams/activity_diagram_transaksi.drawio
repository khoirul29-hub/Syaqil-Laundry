        <mxCell id="e_to_gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;" edge="1" parent="1" source="act_scan_qris" target="act_req_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_gateway_to_third" value="Verifikasi PIN / Otorisasi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;fontColor=#1A202C;fontSize=10;" edge="1" parent="1" source="act_req_gateway" target="dec_verif_pin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Verifikasi PIN: Gagal -> Notifikasi -> Coba lagi -->
        <mxCell id="e_pin_gagal" value="Gagal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;fontColor=#1A202C;fontSize=10;fontStyle=1;" edge="1" parent="1" source="dec_verif_pin" target="act_pin_salah">
          <mxGeometry relative="1" as="geometry" />
