{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 30,
      "regions": ["sin1"],
      "excludeFiles": "{node_modules/**,tests/**,docs/**}"
    }
  },
  "routes": [{ "src": "/api/(.*)", "dest": "/api/index.php" }]
}
