        <mxCell id="e_uang_kurang" value="Kurang" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;fontColor=#1A202C;fontSize=10;fontStyle=1;" edge="1" parent="1" source="dec_verif_uang" target="act_uang_kurang">
