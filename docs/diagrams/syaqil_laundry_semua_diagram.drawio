          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Minta Revisi -> Kembali ke Pemasok Kirim -->
        <mxCell id="edge_loop_revisi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="node_minta_revisi" target="node_pemasok_kirim">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="440" />
              <mxPoint x="290" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Decision: Ya -> Buat Lembar Data -->
