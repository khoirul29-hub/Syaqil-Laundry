        <mxCell id="e_uang_kembali_input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;" edge="1" parent="1" source="act_uang_kurang" target="act_input_tunai">
          <mxGeometry relative="1" as="geometry">
