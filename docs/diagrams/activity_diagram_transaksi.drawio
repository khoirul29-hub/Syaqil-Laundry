        <mxCell id="e_uang_cukup" value="Cukup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;fontColor=#1A202C;fontSize=10;fontStyle=1;" edge="1" parent="1" source="dec_verif_uang" target="act_hitung_kembalian">
          <mxGeometry relative="1" as="geometry">
