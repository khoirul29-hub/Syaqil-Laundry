        <mxCell id="e_nontunai_to_lunas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;" edge="1" parent="1" source="act_pay_sukses" target="act_simpan_lunas">
