        <mxCell id="e_pin_retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A202C;strokeWidth=1.5;" edge="1" parent="1" source="act_pin_salah" target="act_scan_qris">
          <mxGeometry relative="1" as="geometry">
